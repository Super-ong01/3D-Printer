# ===== Print3DHub Slicer API — Environment Variables =====
# Copy ไฟล์นี้เป็น .env แล้วแก้ค่า
# หรือใส่ใน Railway Dashboard > Variables

# Port (Railway จะ set ให้อัตโนมัติ)
PORT=3000

# Origin ที่อนุญาต (ใส่ domain เว็บของคุณ)
# เช่น ALLOWED_ORIGIN=https://print3dhub.com
# หรือ ALLOWED_ORIGIN=* สำหรับทดสอบ
ALLOWED_ORIGIN=*

# Path ของ OrcaSlicer binary
# (Railway + Docker จะ set ให้อัตโนมัติ)
ORCA_BIN=/usr/local/bin/orca-slicer

# Environment
NODE_ENV=production
